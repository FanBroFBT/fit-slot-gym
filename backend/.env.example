# Copy to backend/.env; never commit real API keys.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Optional Gemini fallback when Groq is unavailable.
GEMINI_API_KEY=

# DeepSeek is disabled by default and must be explicitly opted in.
DEEPSEEK_API_KEY=
AI_ALLOW_DEEPSEEK_FALLBACK=0
DEEPSEEK_MODEL=deepseek-chat
